APP_NAME=AcadPulse Platform API
ENVIRONMENT=development
# Local PostgreSQL example:
DATABASE_URL=postgresql+psycopg://acadpulse:acadpulse@localhost:5432/acadpulse
# Managed PostgreSQL (for example Supabase): use the provider connection string
# and keep SSL enabled, e.g. postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:3000,https://shahbaaz42.github.io

# Authentication. Generate a long random secret for deployed environments.
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=60
AUTH_TOKEN_ISSUER=acadpulse
AUTH_TOKEN_AUDIENCE=acadpulse-web

# One-time bootstrap values used by scripts/bootstrap_platform_admin.py
ACADPULSE_BOOTSTRAP_EMAIL=admin@example.com
ACADPULSE_BOOTSTRAP_NAME=AcadPulse Platform Admin
ACADPULSE_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
